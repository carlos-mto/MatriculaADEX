@model IReadOnlyList<EnrollmentRow>
@{
    ViewData["Title"] = "Matrículas";
}
<form method="get" class="card mb-4">
    <div class="card-body grid items-end gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div>
            <label for="period" class="label">Periodo</label>
            <select id="period" name="period" class="input" asp-items='(SelectList)ViewData["Periods"]!'></select>
        </div>
        <div>
            <label for="q" class="label">Alumno</label>
            <input id="q" name="q" value="@ViewData["Q"]" class="input" placeholder="Buscar por nombre" />
        </div>
        <div>
            <label for="courseId" class="label">Curso</label>
            <select id="courseId" name="courseId" class="input" asp-items='(SelectList)ViewData["Courses"]!'>
                <option value="">Todos los cursos</option>
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="overflow-x-auto">
        <table class="table">
            <thead>
                <tr><th>Fecha</th><th>Alumno</th><th>Ciclo</th><th>Turno</th><th>Periodo</th><th># Cursos</th><th class="text-right">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="whitespace-nowrap">@LimaTime.Format(e.CreatedAt)</td>
                        <td class="font-bold">@e.Student</td>
                        <td>@e.Cycle</td>
                        <td>@(e.Shift ?? "-")</td>
                        <td>@e.Period</td>
                        <td>@e.Courses</td>
                        <td class="whitespace-nowrap text-right">
                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-secondary btn-sm"><i class="fa-solid fa-eye"></i> Ver</a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel(e.Id, "¿Anular esta matrícula? Se devolverán los cupos.", "Cancel", "Anular")' />
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="py-8 text-center text-slate-500">No hay registros</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model='(Pager)ViewData["Pager"]!' />
