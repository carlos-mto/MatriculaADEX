@model IReadOnlyList<TeacherRow>
@{
    ViewData["Title"] = "Profesores";
    var estado = ViewData["Estado"] as string;
}
@section Actions {
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Nuevo profesor</a>
}
<form method="get" class="card mb-4">
    <div class="card-body grid items-end gap-3 sm:grid-cols-3">
        <div>
            <label for="q" class="label">Nombre</label>
            <input id="q" name="q" value="@ViewData["Q"]" class="input" placeholder="Buscar por nombre" />
        </div>
        <div>
            <label for="estado" class="label">Estado</label>
            <select id="estado" name="estado" class="input">
                <option value="">Todos</option>
                <option value="activo" selected="@(estado == "activo")">Activos</option>
                <option value="inactivo" selected="@(estado == "inactivo")">Inactivos</option>
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>
<div class="card">
    <div class="overflow-x-auto">
        <table class="table">
            <thead><tr><th>Nombre</th><th>Email</th><th>Especialidad</th><th>Estado</th><th># Horarios</th><th class="text-right">Acciones</th></tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="font-bold">@t.FullName</td>
                        <td>@(t.Email ?? "-")</td>
                        <td>@(t.Specialty ?? "-")</td>
                        <td>
                            @if (t.IsActive) { <span class="badge bg-green-100 text-green-700">Activo</span> }
                            else { <span class="badge bg-slate-200 text-slate-600">Inactivo</span> }
                        </td>
                        <td>@t.Schedules</td>
                        <td class="whitespace-nowrap text-right">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-secondary btn-sm"><i class="fa-solid fa-pen"></i> Editar</a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel(t.Id, "¿Eliminar este profesor?")' />
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="py-8 text-center text-slate-500">No hay registros</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
