@model TeacherForm
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Nuevo profesor" : "Editar profesor";
}
<div class="card max-w-xl">
    <div class="card-body">
        <partial name="_FormErrors" model='""' />
        <form method="post" class="space-y-4">
            <div>
                <label asp-for="FullName" class="label"></label>
                <input asp-for="FullName" class="input" autofocus />
                <span asp-validation-for="FullName" class="mt-1 block text-sm font-bold text-red-600"></span>
            </div>
            <div>
                <label asp-for="Email" class="label"></label>
                <input asp-for="Email" type="email" class="input" />
                <span asp-validation-for="Email" class="mt-1 block text-sm font-bold text-red-600"></span>
            </div>
            <div>
                <label asp-for="Specialty" class="label"></label>
                <input asp-for="Specialty" class="input" />
                <span asp-validation-for="Specialty" class="mt-1 block text-sm font-bold text-red-600"></span>
            </div>
            <div class="flex items-center gap-2">
                <input asp-for="IsActive" class="h-4 w-4 rounded border-slate-300" />
                <label asp-for="IsActive" class="label mb-0"></label>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
