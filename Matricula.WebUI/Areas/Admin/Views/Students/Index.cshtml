@model IReadOnlyList<Student>
@{
    ViewData["Title"] = "Alumnos";
}
@section Actions {
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Nuevo alumno</a>
}
<form method="get" class="card mb-4">
    <div class="card-body grid items-end gap-3 sm:grid-cols-3">
        <div>
            <label for="q" class="label">Nombre</label>
            <input id="q" name="q" value="@ViewData["Q"]" class="input" placeholder="Buscar por nombre" />
        </div>
        <div>
            <label for="cycle" class="label">Ciclo</label>
            <select id="cycle" name="cycle" class="input" asp-items='(SelectList)ViewData["Cycles"]!'><option value="">Todos</option></select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>
<div class="card">
    <div class="overflow-x-auto">
        <table class="table">
            <thead><tr><th>Nombre completo</th><th>Ciclo</th><th class="text-right">Acciones</th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="font-bold">@s.FullName</td>
                        <td>@s.Cycle</td>
                        <td class="whitespace-nowrap text-right">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-secondary btn-sm"><i class="fa-solid fa-pen"></i> Editar</a>
                            <partial name="_DeleteButton" model='new DeleteButtonModel(s.Id, "¿Eliminar este alumno?")' />
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="py-8 text-center text-slate-500">No hay registros</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model='(Pager)ViewData["Pager"]!' />
