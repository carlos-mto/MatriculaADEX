@model IReadOnlyList<CatalogRow>
@{
    ViewData["Title"] = "Cursos";
    ViewData["CountLabel"] = "Horarios";
    ViewData["DeleteMessage"] = "¿Eliminar este curso?";
}
@section Actions {
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Nuevo curso</a>
}
<partial name="_CatalogIndex" model="Model" view-data="ViewData" />
