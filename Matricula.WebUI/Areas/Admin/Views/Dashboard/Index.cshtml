@model DashboardStats
@{
    ViewData["Title"] = "Panel";
    var period = ViewData["Period"] as string;
    var cards = new[]
    {
        (Label: "Alumnos", Value: Model.Students, Icon: "fa-user-graduate"),
        (Label: "Profesores activos", Value: Model.ActiveTeachers, Icon: "fa-chalkboard-user"),
        (Label: "Cursos", Value: Model.Courses, Icon: "fa-book"),
        (Label: "Aulas", Value: Model.ClassRooms, Icon: "fa-door-open"),
        (Label: $"Matrículas del periodo {period}", Value: Model.Enrollments, Icon: "fa-clipboard-list")
    };
}

<div class="mb-6 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-5">
    @foreach (var c in cards)
    {
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between text-brand-600"><i class="fa-solid @c.Icon text-xl"></i></div>
                <div class="mt-2 text-3xl font-extrabold text-slate-900">@c.Value</div>
                <div class="text-sm font-bold text-slate-600">@c.Label</div>
            </div>
        </div>
    }
</div>

<div class="card mb-6">
    <div class="card-header"><h2 class="text-lg font-bold text-brand-700">Ocupación por horario</h2></div>
    <div class="overflow-x-auto">
        <table class="table">
            <thead>
                <tr>
                    <th>Curso</th><th>Ciclo</th><th>Turno</th><th>Aula</th><th>Profesor</th><th>Horario</th>
                    <th>Matriculados</th><th>Cupos disponibles</th><th>Ocupación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Schedules)
                {
                    var total = s.Enrolled + s.Capacity;
                    var pct = total == 0 ? 0 : (int)Math.Round(100.0 * s.Enrolled / total);
                    <tr>
                        <td class="font-bold">@s.CourseName</td>
                        <td>@s.Cycle</td>
                        <td>@s.ShiftName</td>
                        <td>@s.ClassRoomName</td>
                        <td>@(s.TeacherName ?? "Por asignar")</td>
                        <td class="whitespace-nowrap">@s.StartTime.ToString(@"hh\:mm")–@s.EndTime.ToString(@"hh\:mm")</td>
                        <td>@s.Enrolled</td>
                        <td class="@(s.Capacity == 0 ? "font-bold text-red-600" : "")">@s.Capacity</td>
                        <td>
                            <div class="h-2 w-28 rounded-full bg-slate-200" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct">
                                <div class="h-2 rounded-full @(s.Capacity == 0 ? "bg-red-500" : "bg-brand-500")" style="width:@(pct)%"></div>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Schedules.Count == 0)
                {
                    <tr><td colspan="9" class="py-8 text-center text-slate-500">No hay registros</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2 class="text-lg font-bold text-brand-700">Carga de profesores</h2></div>
    <div class="overflow-x-auto">
        <table class="table">
            <thead><tr><th>Nombre</th><th>Estado</th><th># Horarios</th><th>Horas/semana</th></tr></thead>
            <tbody>
                @foreach (var t in Model.TeacherLoads)
                {
                    <tr>
                        <td class="font-bold">@t.FullName</td>
                        <td>
                            @if (t.IsActive) { <span class="badge bg-green-100 text-green-700">Activo</span> }
                            else { <span class="badge bg-slate-200 text-slate-600">Inactivo</span> }
                        </td>
                        <td>@t.ScheduleCount</td>
                        <td>@t.WeeklyHours.ToString("0.##")</td>
                    </tr>
                }
                @if (Model.TeacherLoads.Count == 0)
                {
                    <tr><td colspan="4" class="py-8 text-center text-slate-500">No hay registros</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
