@{
    ViewData["Title"] = "Adex Instituto de Educación Superior";
}

    <div class="row h-100">

    
    <div class="col-md-7  d-none d-lg-flex">
        <div class="row justify-content-center align-self-center my-auto"> 
       
        <div class="banner-2026">
            <img src="~/images/logo_adex.svg" alt="ADEX Instituto" class="banner-logo">
            <p class="banner-kicker">Matrícula abierta</p>
            <h2 class="banner-title">Ingresos<br><span>2026</span></h2>
            <p class="banner-subtitle">Instituto de Educación Superior ADEX</p>
            <ul class="banner-benefits">
                <li><i class="fa-solid fa-circle-check"></i> Turnos mañana, tarde y noche</li>
                <li><i class="fa-solid fa-circle-check"></i> Cupos limitados por curso</li>
                <li><i class="fa-solid fa-circle-check"></i> Beneficios especiales al matricularte</li>
            </ul>
            <p class="banner-footer">¡Inscríbete hoy!</p>
        </div>
        </div>

       
         
    </div>
    <div class="col-12 col-lg-5">
         <div class="card shadow bg-white">
        <div class="card-header">
        <h2 class="title_matricula">Matricúlate ya <br><small>y obtén beneficios especiales</small></h2>
        </div>

        <div class="card-body py-1 px-1">
            <div id="matricula">
              
                <div class="matricula overflow-auto">
                    <div style="min-width: 400px">
                        @if (TempData["Error"] is string err)
                        {
                            <div class="alert alert-danger">@err</div>
                        }
                        <form method="post" id="registro_matricula">
                        <header>
                            <div class="row">
                               
                                <div class="col">
                                    <div class="mb-3">
                                        <label for="studentSelect">Estudiante</label>
                                       
                                         
                                         <select class="form-select form-select-lg"  id="studentSelect" name="studentSelect" data-msg="El estudiante no puede estar vacio">
                                             <option value="" >Seleccionar Estudiante</option>
                                            @{
                                                foreach (var student in ViewBag.Students)
                                                {
                                                    var idString =  student.Id.ToString();
                                                    <option value="@idString" data-cycle="@student.Cycle">@student.FullName</option>
                                                }
                                            }
                                         </select>

                                       
                                    </div>

                                    <div class="mb-3">
                                        <label for="shiftSelect">Turno</label>
                                        <select class="form-select form-select-lg" asp-items="ViewBag.Shifts" id="shiftSelect"  name="shiftSelect" data-msg="El turno no puede estar vacio"></select>
                                        
                                    </div>

                                   

                                    <div class="mb-3">
                                        <label for="courseSelect">Curso</label>

                                        <div class="input-group">
                                             <select class="form-select form-select-lg" id="courseSelect" name="courseSelect"><option value="">Seleccionar Curso</option></select>

                                                <a class="btn btn-secondary btn_add" href="javascript:;">+</a>

                                           
                                        </div>
                                         <label id="courseSelect-error" class="error_course" for="courseSelect">No se selecciono ningun curso</label>
                                      
                                    </div>

                                </div>
                            </div>
                        </header>
                       
                        <main>
                            <input type="hidden" name="listCourses" id="listCourses" value=""  data-msg="No se agregaron cursos">
                            <table width="100%" id="courses">
                               
                                <tbody>
                                    
                                    
                                   
                                   
                                </tbody>
                               
                            </table>

                            <a class="btn btn-primary btn-lg w-100" id="register" href="javascript:;">Registrar</a>
                            
                        </main>
                         </form>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>

    </div>
</div>
