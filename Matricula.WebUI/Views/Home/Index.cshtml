@{
    ViewData["Title"] = "Adex Instituto de Educación Superior";
}

<div class="grid items-start gap-8 lg:grid-cols-12">
    <div class="hidden justify-center lg:col-span-7 lg:flex">
        <div class="max-w-md rounded-2xl bg-gradient-to-br from-brand-700 to-brand-600 px-10 py-12 text-white shadow-2xl shadow-brand-700/40">
            <img src="~/images/logo_adex.svg" alt="ADEX Instituto" class="mb-6 h-14">
            <p class="mb-2 text-sm uppercase tracking-[0.15em] opacity-85">Matrícula abierta</p>
            <h2 class="mb-3 text-5xl font-extrabold uppercase leading-none">Ingresos<br><span class="text-accent">2026</span></h2>
            <p class="mb-6 text-lg opacity-90">Instituto de Educación Superior ADEX</p>
            <ul class="mb-6 space-y-2">
                <li><i class="fa-solid fa-circle-check mr-2 text-accent"></i> Turnos mañana, tarde y noche</li>
                <li><i class="fa-solid fa-circle-check mr-2 text-accent"></i> Cupos limitados por curso</li>
                <li><i class="fa-solid fa-circle-check mr-2 text-accent"></i> Beneficios especiales al matricularte</li>
            </ul>
            <p class="text-2xl font-extrabold text-accent">¡Inscríbete hoy!</p>
        </div>
    </div>

    <div class="lg:col-span-5">
        <div class="card">
            <div class="card-header">
                <h2 class="text-3xl font-bold leading-tight text-brand-600">Matricúlate ya <br><small class="text-lg font-normal text-slate-600">y obtén beneficios especiales</small></h2>
            </div>

            <div class="card-body">
                @if (TempData["Error"] is string err)
                {
                    <div class="alert-error mb-4">@err</div>
                }
                <form method="post" id="registro_matricula" class="space-y-4">
                    <div>
                        <label for="studentSelect" class="label">Estudiante</label>
                        <select class="input" id="studentSelect" name="studentSelect" data-msg="El estudiante no puede estar vacio">
                            <option value="">Seleccionar Estudiante</option>
                            @{
                                foreach (var student in ViewBag.Students)
                                {
                                    var idString = student.Id.ToString();
                                    <option value="@idString" data-cycle="@student.Cycle">@student.FullName</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label for="shiftSelect" class="label">Turno</label>
                        <select class="input" asp-items="ViewBag.Shifts" id="shiftSelect" name="shiftSelect" data-msg="El turno no puede estar vacio"></select>
                    </div>

                    <div>
                        <label for="courseSelect" class="label">Curso</label>
                        <div class="flex">
                            <select class="input rounded-r-none" id="courseSelect" name="courseSelect"><option value="">Seleccionar Curso</option></select>
                            <a class="btn btn-primary btn_add rounded-l-none text-xl" href="javascript:;" aria-label="Agregar curso">+</a>
                        </div>
                        <label id="courseSelect-error" class="error_course" for="courseSelect">No se selecciono ningun curso</label>
                    </div>

                    <input type="hidden" name="listCourses" id="listCourses" value="" data-msg="No se agregaron cursos">
                    <table class="w-full" id="courses">
                        <tbody>
                        </tbody>
                    </table>

                    <a class="btn btn-primary w-full py-3 text-lg" id="register" href="javascript:;">Registrar</a>
                </form>
            </div>
        </div>
    </div>
</div>
