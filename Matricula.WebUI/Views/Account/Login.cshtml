@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header">
                <h2>Iniciar sesión</h2>
            </div>
            <div class="card-body">
                <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Username">Usuario</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                </form>
            </div>
        </div>
    </div>
</div>
