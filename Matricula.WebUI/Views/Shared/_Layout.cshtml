<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ADEX Matrícula</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css"
        integrity="sha512-KfkfwYDsLkIlwQp6LFnl8zNdLGxu9YAA1QvwINks4PhcElQSvqcyVLLD9aMhXd13uQjoXtEKNosOWaZqXgel0g=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link href="~/favicon.png" rel="shortcut icon" type="image/x-icon">
</head>

<body class="font-sans text-slate-800 antialiased">
    <header class="sticky top-0 z-40 bg-gradient-to-r from-[#15298e] via-[#582c8f] to-[#cf3896] shadow-lg">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-4">
            <a href="~/" class="shrink-0">
                <img class="h-12 w-auto brightness-200 grayscale" src="~/images/logo_adex.svg" alt="ADEX">
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button type="button" id="nav-toggle" aria-controls="nav-menu" aria-expanded="false"
                    class="rounded-md px-3 py-2 text-white ring-1 ring-white/40 hover:bg-white/10 md:hidden">
                    <i class="fa-solid fa-bars"></i><span class="sr-only">Menú</span>
                </button>
                <nav id="nav-menu" class="hidden w-full flex-col gap-3 text-white md:flex md:w-auto md:flex-row md:items-center md:gap-6">
                    <a asp-controller="Home" asp-action="Index" class="font-bold hover:text-accent">Matrícula</a>
                    <a href="/Admin" class="font-bold hover:text-accent">Administración</a>
                    <span class="text-white/80"><i class="fa-solid fa-user mr-1"></i>@User.Identity.Name</span>
                    <form method="post" asp-controller="Account" asp-action="Logout">
                        <button type="submit" class="btn btn-sm text-white ring-1 ring-white/60 hover:bg-white/10">Cerrar sesión</button>
                    </form>
                </nav>
            }
        </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-8">
        @RenderBody()
    </div>

    <dialog id="dialog-confirm" class="m-auto w-[90vw] max-w-sm rounded-xl p-0 shadow-2xl backdrop:bg-black/50">
        <div class="p-5">
            <span class="alert_content block text-base font-bold text-red-600"></span>
        </div>
        <div class="flex justify-end border-t border-slate-200 px-5 py-3">
            <button type="button" class="btn btn-danger btn_close_modal">Okey</button>
        </div>
    </dialog>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById("nav-toggle")?.addEventListener("click", function () {
            var m = document.getElementById("nav-menu"); m.classList.toggle("flex"); var open = m.classList.toggle("hidden") === false;
            this.setAttribute("aria-expanded", open);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
